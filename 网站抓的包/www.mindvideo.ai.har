            "size": 3005,
            "mimeType": "application/json",
            "text": "{\"code\":0,\"message\":\"Success\",\"data\":[{\"id\":16576744,\"user_id\":272606,\"bot_id\":292,\"bot\":{\"id\":292,\"name\":\"GPT Image 2 Free\",\"level\":\"none\",\"options\":[{\"type\":\"prompt\",\"title\":\"\\u63d0\\u793a\\u8bcd\",\"fillRule\":{\"required\":true,\"maxLength\":1000,\"minLength\":2},\"identifier\":\"prompt\",\"placeholder\":\"\\u4f60\\u60f3\\u8981\\u521b\\u5efa\\u4ec0\\u4e48?\",\"word_options\":[{\"label\":\"Cozy Bookshelves\",\"value\":\"A cozy library scene featuring wooden bookshelves filled with a diverse collection of books. Warm lighting from a small lamp casts a gentle glow over the shelves, highlighting the spines and creating an inviting atmosphere. Various small decorative items are placed among the books, adding character to the scene. Ultra-high definition, 4K.\"},{\"label\":\"Modern Cityscape\",\"value\":\"A stunning view of a futuristic city skyline dominated by a towering, iconic skyscraper. The city is bustling with modern infrastructure, including complex roadways and architectural marvels. The scene captures the dynamic energy of urban life with vibrant colors of the buildings reflecting the soft glow of the setting sun in the sky. Ultra-high definition, 4K.\"},{\"label\":\"Lake\",\"value\":\"A breathtaking view of a mountain landscape featuring majestic peaks under a partly cloudy sky. The tranquil lake in the foreground reflects the mountains perfectly, creating a symmetrical, mirror-like effect. Tall pine trees line the shore, adding depth and emphasizing the natural beauty of the scene. Ultra-high definition, 4K.\"}],\"identifierMap\":{\"translate_prompt\":\"is_translate\"}},{\"type\":\"aspect_ratio\",\"title\":\"\\u957f\\u5bbd\\u6bd4\",\"options\":[{\"label\":\"Auto\",\"value\":\"auto\"},{\"label\":\"16:9\",\"value\":\"16:9\"},{\"label\":\"9:16\",\"value\":\"9:16\"},{\"label\":\"1:1\",\"value\":\"1:1\"},{\"label\":\"3:2\",\"value\":\"3:2\"},{\"label\":\"2:3\",\"value\":\"2:3\"},{\"label\":\"3:4\",\"value\":\"3:4\"}],\"identifier\":\"size\",\"description\":\"\\u9009\\u62e9\\u5408\\u9002\\u7684\\u957f\\u5bbd\\u6bd4\"}],\"is_enable\":true,\"credits_rules\":{\"credits\":[],\"vip_limit\":8,\"free_limit\":4,\"description\":\"\\u590d\\u6742\\u63d0\\u793a\\u4e0b\\u4ecd\\u80fd\\u751f\\u6210\\u9ad8\\u4e00\\u81f4\\u3001\\u771f\\u5b9e\\u3001\\u53ef\\u63a7\\u56fe\\u50cf\\u3002\",\"image_specs\":[],\"subscription\":{\"mode\":{\"pro\":false,\"std\":false}},\"use_limit_key\":\"free_gpt_image_2\"}},\"model\":{\"id\":197,\"name\":\"Image-T-GPT-Image-2-Free\",\"model_key\":\"gpt-image-2\",\"estimated_duration_min\":0,\"estimated_duration_max\":0},\"model_id\":197,\"type\":8,\"category\":\"image\",\"prompt\":\"a cat\",\"options\":{\"size\":\"auto\",\"prompt\":\"a cat\",\"history_images\":[]},\"cover_url\":null,\"task_progress\":\"0\",\"task_id\":null,\"task_status\":\"pending\",\"updated_at\":\"2026-05-15T07:07:08.000000Z\",\"created_at\":\"2026-05-15T07:07:08.000000Z\",\"results_count\":1,\"task_remark\":\"The image is being created,which may take 3 minutes.\",\"results\":[],\"effect_template\":null,\"relation_map\":{\"image_keys\":[],\"video_keys\":[],\"aspect_ratio_keys\":[\"size\"],\"resolution_keys\":[],\"duration_keys\":[]},\"queue_count\":31,\"generate_duration\":0,\"estimated_duration\":{\"min\":10,\"max\":120}}],\"timestamp\":1778828829}"
